DJANGO_SETTINGS_MODULE=config.settings
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=*

DB_NAME=rag_service
DB_USER=rag_user
DB_PASSWORD=rag_password
DB_HOST=postgres
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-redis-password

FLOWER_BASIC_AUTH=admin:change-me

THROTTLE_ANON=30/minute
THROTTLE_USER=120/minute

DOMAIN_URL=localhost:8000
STATIC_URL=/static/
STATIC_ROOT=/app/src/static
MEDIA_URL=/media/
MEDIA_ROOT=/app/src/media

RAG_ENABLED=True
RAG_DEFAULT_TENANT_ID=default
RAG_VECTOR_COLLECTION_PREFIX=rag

RAG_QDRANT_URL=https://your-cluster.qdrant.io:6333
RAG_QDRANT_API_KEY=your-qdrant-api-key

RAG_LLM_API_KEY=unused
RAG_LLM_ENDPOINT=http://localhost:12434/engines/llama.cpp/v1
RAG_LLM_BASE_URL=${RAG_LLM_ENDPOINT}
RAG_LLM_MODEL=ai/qwen3:4b
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=1024

RAG_EMBEDDING_ENDPOINT=http://localhost:12434/engines/llama.cpp/v1
RAG_EMBEDDING_BASE_URL=${RAG_EMBEDDING_ENDPOINT}
RAG_EMBEDDING_MODEL=ai/baai/bge-small-en-v1.5
RAG_EMBEDDING_MODEL_VERSION=latest

RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MODEL_TIMEOUT_SECONDS=60

RAG_REEMBED_ON_VERSION_MISMATCH=True
RAG_REEMBED_BATCH_SIZE=64